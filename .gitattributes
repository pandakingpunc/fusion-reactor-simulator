*.ttf binary
*.otf binary
*.pdf binary
*.png binary
# Golden regression files are machine-written with LF; keep them byte-identical on every OS
test/golden/** text eol=lf
# Figure text outputs are hashed in figures.manifest.json; keep checkouts byte-identical (not docs/figures/**: that would override *.pdf binary)
docs/figures/*.svg text eol=lf
docs/figures/*.md text eol=lf
docs/figures/*.json text eol=lf
# The generated configuration reference (npm run docs:config) is written with LF
docs/config-reference.md text eol=lf
# Shebang scripts are imported as modules (src/docs/paper.test.ts imports scripts/check-bib.mjs).
# A CRLF checkout leaves \r on the shebang line, which Node rejects as an invalid token.
*.mjs text eol=lf
