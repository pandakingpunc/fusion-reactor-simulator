{
  "name": "fusion-reactor-simulator",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "fusion-sim": "build/lib/fusion-sim.js"
  },
  "main": "./build/lib/index.cjs",
  "module": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js",
      "require": "./build/lib/index.cjs"
    },
    "./io": {
      "types": "./build/lib/io.d.ts",
      "import": "./build/lib/io.js",
      "require": "./build/lib/io.cjs"
    },
    "./schema": "./schema/fusion-sim.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "build/lib",
    "schema",
    "python",
    "docs/config-reference.md",
    "README.md",
    "LICENSE",
    "CITATION.cff",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:lib": "node scripts/build-lib.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:levels": "node scripts/coverage-levels.mjs",
    "mutation-smoke": "node scripts/mutation-smoke.mjs",
    "typecheck:strict": "node scripts/typecheck-strict.mjs",
    "validate": "tsx src/cli/validate.cli.ts",
    "golden": "tsx src/cli/golden.cli.ts",
    "golden:update": "tsx src/cli/golden.cli.ts --update",
    "schema": "tsx scripts/gen-schema.ts",
    "schema:check": "tsx scripts/gen-schema.ts --check",
    "schema:scenario": "tsx scripts/gen-scenario-schema.ts",
    "schema:scenario:check": "tsx scripts/gen-scenario-schema.ts --check",
    "docs:config": "tsx scripts/gen-config-reference.ts",
    "docs:config:check": "tsx scripts/gen-config-reference.ts --check",
    "missions": "tsx src/cli/missions.cli.ts",
    "uq": "tsx src/cli/uq.cli.ts",
    "scan": "tsx src/cli/scan.cli.ts",
    "optimize": "tsx src/cli/optimize.cli.ts",
    "stress:exit": "node scripts/stress-exit.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "release:check": "node scripts/release-check.mjs",
    "paper:numbers": "tsx scripts/paper-numbers.ts",
    "paper:check": "node scripts/check-bib.mjs && tsx scripts/paper-numbers.ts --check",
    "figures": "tsx src/cli/figures.cli.ts",
    "figures:check": "tsx src/cli/figures.cli.ts --check",
    "bench:convergence": "tsx bench/convergence.ts",
    "bench:perf": "tsx bench/perf.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
