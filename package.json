{
  "name": "fusion-reactor-simulator",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage --testTimeout=30000",
    "mutation-smoke": "node scripts/mutation-smoke.mjs",
    "typecheck:strict": "node scripts/typecheck-strict.mjs",
    "validate": "tsx src/cli/validate.cli.ts",
    "golden": "tsx src/cli/golden.cli.ts",
    "golden:update": "tsx src/cli/golden.cli.ts --update",
    "stress:exit": "node scripts/stress-exit.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "release:check": "node scripts/release-check.mjs",
    "figures": "tsx src/cli/figures.cli.ts",
    "figures:check": "tsx src/cli/figures.cli.ts --check",
    "bench:convergence": "tsx bench/convergence.ts",
    "bench:perf": "tsx bench/perf.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
